<UserControl x:Class="SlimsteMens.Wpf.Views.Controls.FinaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Ellipse Width="200" Height="200" Stroke="{StaticResource AccentBrush}" StrokeThickness="4" />
        <TextBlock Text="{Binding RemainingSeconds}" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
