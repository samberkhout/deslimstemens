<UserControl x:Class="SlimsteMens.Wpf.Views.Controls.AudienceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Presenter.Game.Rounds[Presenter.RoundIndex].Questions[Presenter.QuestionIndex].Text}"
                   FontSize="48" TextWrapping="Wrap" Margin="0,0,0,20" />
        <ItemsControl ItemsSource="{Binding Presenter.Game.Rounds[Presenter.RoundIndex].Questions[Presenter.QuestionIndex].Options}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" FontSize="32" Margin="0,8" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
